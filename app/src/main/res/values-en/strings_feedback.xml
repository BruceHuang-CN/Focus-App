<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Entry point -->
    <string name="feedback_report_entry_title">Report an issue</string>
    <string name="feedback_report_entry_description">Describe the problem inside the app and attach optional diagnostics, then submit it to the developer in one tap.</string>
    <string name="feedback_report_entry_action">Write a report</string>

    <!-- Screen -->
    <string name="feedback_report_title">Report an issue</string>
    <string name="feedback_report_problem_label">What went wrong? (required)</string>
    <string name="feedback_report_problem_placeholder">Example: I enabled the guardian, opened an app, waited 30 seconds, and saw no reminder. It happened twice. Describe what actually happened to you.</string>
    <string name="feedback_report_steps_label">What you did (optional)</string>
    <string name="feedback_report_steps_placeholder">If needed, add the actions in order: what you did first and what you tapped next.</string>
    <string name="feedback_report_expected_label">What did you expect? (optional)</string>
    <string name="feedback_report_expected_placeholder">For example: a reminder about 10 seconds after entering Xiaohongshu.</string>
    <string name="feedback_report_steps_section_toggle">Add steps and expectations (optional)</string>
    <string name="feedback_report_steps_section_toggle_expanded">Hide optional details</string>
    <string name="feedback_report_counter">%1$d/%2$d</string>
    <string name="feedback_report_required">Please describe the problem first.</string>
    <string name="feedback_report_too_long">Over the %1$d character limit. Please shorten it before submitting.</string>

    <!-- Diagnostic levels -->
    <string name="feedback_report_diagnostics_toggle">Attach basic diagnostics (recommended)</string>
    <string name="feedback_report_diagnostics_toggle_hint">Includes device and version, permissions and service status, guardian app count, reminder quota, and display settings. Preview first if you wish. No task text, app list, or API keys.</string>
    <string name="feedback_report_diagnostics_more_options">More diagnostic options</string>
    <string name="feedback_report_diagnostics_less_options">Hide diagnostic options</string>
    <string name="feedback_report_diagnostics_detailed_toggle">Attach detailed diagnostics</string>
    <string name="feedback_report_diagnostics_detailed_hint">Also includes system language, service history times, and reminder delay settings.</string>
    <string name="feedback_report_show_diagnostics">View diagnostics</string>
    <string name="feedback_report_diagnostics_title">Diagnostics to attach</string>
    <string name="feedback_report_diagnostics_close">Close</string>
    <string name="feedback_report_loading_diagnostics">Reading diagnostics…</string>
    <string name="feedback_report_diagnostics_failed">Diagnostics could not be read. The report marks those fields as unavailable.</string>
    <string name="feedback_report_refresh_diagnostics">Refresh diagnostics</string>

    <!-- Submission -->
    <string name="feedback_report_privacy_note">The developer reads feedback privately at brucehere.com. Describe the issue; you do not need to suggest a fix. Automatic diagnostics are sent with the report and can be viewed or turned off before submitting.</string>
    <string name="feedback_report_submit_action">Submit report</string>
    <string name="feedback_report_submitting">Submitting…</string>
    <string name="feedback_report_preview_action">View what will be sent</string>
    <string name="feedback_report_preview_title">Full content to be sent</string>
    <string name="feedback_report_success_title">Received, thank you</string>
    <string name="feedback_report_success_message">Receipt</string>
    <string name="feedback_report_copy_receipt">Copy receipt</string>
    <string name="feedback_report_copy_receipt_success">Receipt copied to the clipboard.</string>
    <string name="feedback_report_copy_receipt_failed">Could not access the clipboard. Please try again.</string>
    <string name="feedback_report_start_new">Report another issue</string>
    <string name="feedback_report_restored_title">An earlier report was not confirmed</string>
    <string name="feedback_report_restored_message">Your previous text and diagnostics have been restored. You can retry the same submission or start a new report.</string>
    <string name="feedback_report_retry_action">Retry submission</string>
    <string name="feedback_report_error_unavailable">Receipt not confirmed. Your content is saved. The network or service may be temporarily unavailable. Please try again later.</string>
    <string name="feedback_report_error_rejected">The server did not accept this submission (%1$s). Please review the content and try again.</string>
    <string name="feedback_report_error_conflict">This report conflicts with an existing record. Please edit it and submit as a new report.</string>
    <string name="feedback_report_error_rate_limited">Submitting too often. Please try again in about %1$d seconds.</string>

    <!-- Fallback ways -->
    <string name="feedback_report_other_ways_hint">Other ways: generate the content, then copy or share it.</string>
    <string name="feedback_report_share_action">Share</string>
    <string name="feedback_report_copy_action">Copy report</string>
    <string name="feedback_report_copy_success">Report copied to the clipboard.</string>
    <string name="feedback_report_copy_failed">Could not access the clipboard. Please try again.</string>
    <string name="feedback_report_share_failed">No app can receive this text. You can copy the report and send it manually.</string>
    <string name="feedback_report_share_hint">Sharing and copying are fallbacks only. They do not mean the server confirmed receipt.</string>
    <string name="feedback_report_share_subject">Huishen issue report</string>
    <string name="feedback_report_clip_label">Huishen issue report</string>

