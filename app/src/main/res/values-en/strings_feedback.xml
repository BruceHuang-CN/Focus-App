    <!-- 清晰描述与可见的自动诊断补充 -->
    <string name="feedback_guide_intro">No need to diagnose the cause. Tell us what you did and what happened.</string>
    <string name="feedback_guide_choose">Need help describing it? Choose a tip (optional)</string>
    <string name="feedback_guide_guardian">Guardian / reminders</string>
    <string name="feedback_guide_ui">Screen / actions</string>
    <string name="feedback_guide_other">Other issues</string>
    <string name="feedback_guide_guardian_hint">Which app did you open, how long did you wait, and did a reminder appear? If you remember, add the approximate time and whether it happens every time or occasionally.</string>
    <string name="feedback_guide_ui_hint">Which screen and button were involved, and what did you see? For example, hidden text, a screen that will not scroll, or a button that does not respond.</string>
    <string name="feedback_guide_other_hint">What did you do before the issue? Was there an error message, and did trying again help? Leave anything you do not remember blank.</string>
    <string name="feedback_report_combined_too_long">Your steps plus automatic diagnostics exceed 2,000 characters. Shorten the steps or turn off diagnostics. Your original text has not been truncated.</string>
    <string name="feedback_context_header">Automatic diagnostic supplement</string>
    <string name="feedback_context_note">Collected now. These values do not reconstruct the issue or establish its cause.</string>
